# Copy to .env. Do not commit .env or real credentials.
PORT=8080
STORAGE_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_rag
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+08:00

# Required: at least 32 characters. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

CHAT_API_KEY=
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Keep the Java project's configured default; set a model available to your account.
CHAT_MODEL=qwen3.8-flash

# Local embedding model: separate from the chat model, no API key needed.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_REVISION=6fa4bf687ce79106377b66d10009c0e513715e24
MODEL_CACHE_DIR=.cache/models
UPLOAD_TEMP_DIR=.tmp/uploads
# API and Worker must use the same persistent original-file directory and model configuration.
ORIGINALS_DIR=.data/originals
VECTOR_DRIVER=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=rag
QDRANT_API_KEY=
QUEUE_DRIVER=bullmq
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=ai-rag
# Keep superseded/deleted indexes for requests already in progress (chat timeout: 180s).
INDEX_RETENTION_MS=600000
# Resource limit for merged documents (128 MiB), not the multipart limit (10 MiB).
MAX_DOCUMENT_BYTES=134217728
