# Copy to .env. Do not commit .env or real credentials.
PORT=8080
STORAGE_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_rag
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+08:00

# Required: at least 32 characters. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

CHAT_API_KEY=
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Keep the Java project's configured default; set a model available to your account.
CHAT_MODEL=qwen3.8-flash

# New indexes use a separate API vector space; legacy 384D indexes remain readable.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_REVISION=api-v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
# Conservative UTF-8 byte budget works offline. Or use a verified matching local tokenizer directory.
EMBEDDING_TOKENIZER=estimate:utf8-v1
CHAT_TOKENIZER=estimate:utf8-v1
CHAT_CONTEXT_TOKENS=32768
CHAT_OUTPUT_TOKENS=4096
RAG_EVIDENCE_TOKENS=8000
RAG_HISTORY_TOKENS=2048
QUERY_PLAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QUERY_PLAN_MODEL=qwen3.8-flash
QUERY_PLAN_API_KEY=
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=
# Must be calibrated on the tuning set; 0 is an uncalibrated starting baseline.
RERANK_MIN_SCORE=0
QUALITY_MODEL_TIMEOUT_MS=20000
MODEL_CACHE_DIR=.cache/models
UPLOAD_TEMP_DIR=.tmp/uploads
# API and Worker must use the same persistent original-file directory and model configuration.
ORIGINALS_DIR=.data/originals
VECTOR_DRIVER=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=rag
QDRANT_API_KEY=
QUEUE_DRIVER=bullmq
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=ai-rag
# Keep superseded/deleted indexes for requests already in progress (chat timeout: 180s).
INDEX_RETENTION_MS=600000
# Resource limit for merged documents (128 MiB), not the multipart limit (10 MiB).
MAX_DOCUMENT_BYTES=134217728
